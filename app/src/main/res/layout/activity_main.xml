            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnCreate"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintDimensionRatio="3.28:1.12"

                app:layout_constraintBottom_toTopOf="@+id/btnCosplay"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/img_home1_frame"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:strokeWidth="2dp"
                    app:cardCornerRadius="20dp"
                    app:strokeColor="@color/app_color"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" >
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:background="@drawable/img_frame_home1"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/img_home1_1_frame"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:adjustViewBounds="true"

                            android:src="@drawable/img_frame_home1_1"
                            app:layout_constraintDimensionRatio="1.1:1.12"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.cute.anime.avatarmaker.utils.OuterStrokeTextView
                            android:paddingStart="2dp"
                            android:id="@+id/tv1"
                            style="@style/single_marquee"
                            android:layout_width="0dp"
                            android:gravity="center"
                            android:layout_height="0dp"
                            android:elevation="2dp"
                            android:fontFamily="@font/janda_manatee_solid"
                            android:shadowColor="#241C39"
                            android:shadowDx="2"
                            android:shadowDy="10"
                            android:shadowRadius="1"
                            android:text="@string/pony_maker"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/img_home1_1_frame"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:outerStrokeColor="@color/app_color"
                            app:outerStrokeWidth="1.5dp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/btnCosplay"
                android:layout_width="0dp"
                android:layout_height="0dp"
