                            app:layout_constraintStart_toStartOf="parent"

                            android:src="@drawable/img_frame_home4_1"
                            app:layout_constraintDimensionRatio="1.1:1.12"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.cute.anime.avatarmaker.utils.OuterStrokeTextView
