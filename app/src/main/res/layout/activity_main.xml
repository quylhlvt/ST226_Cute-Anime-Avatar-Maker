                            android:src="@drawable/img_frame_home3_1"
                            app:layout_constraintDimensionRatio="1.1:1.12"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.cute.anime.avatarmaker.utils.OuterStrokeTextView
                            android:id="@+id/tv3"
